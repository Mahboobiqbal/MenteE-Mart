# Supabase (frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Admin access
VITE_ADMIN_PASSCODE=admin123
# Used for silent Supabase sign-in after the passcode (enables admin writes + image uploads).
# Use a unique password for the Supabase auth user - never reuse your email password.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=

# Storefront
VITE_WHATSAPP_NUMBER=923000000000
VITE_STORE_NAME=Mena Bazar
VITE_STORE_PHONE=923000000000
VITE_EASYPAISA_ACCOUNT_NUMBER=03XX-XXXXXXX
VITE_EASYPAISA_ACCOUNT_TITLE=Mena Bazar
VITE_GROQ_API_KEY=

# Server-only (Vercel environment variables - never prefixed with VITE_)
# Required for /api/upload and /api/create-product serverless endpoints.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_PASSCODE=admin123
